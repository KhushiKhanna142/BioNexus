# BioNexus / MOSAIC Environment Configuration Template
# Copy to .env and fill in values. NEVER commit secrets or tokens.
# Token exposure incident cited: secret scanning enforced with gitleaks.

# MLflow & DagsHub Tracking
DAGSHUB_USER=
DAGSHUB_TOKEN=
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT=bionexus-cancer-subtype

# Serving Configuration
BIONEXUS_HOST=0.0.0.0
BIONEXUS_PORT=8000
BIONEXUS_MODEL_URI=models:/mosaic-subtype-classifier/Production
BIONEXUS_SERVING_DIR=data/serving
BIONEXUS_ALLOW_MOCK=false
BIONEXUS_ALLOW_LOCAL_FALLBACK=false

# Polygon Blockchain Anchoring (Optional / Testnet)
POLYGON_RPC_URL=
POLYGON_PRIVATE_KEY=
POLYGON_CONTRACT_ADDRESS=
