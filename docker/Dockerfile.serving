# Separate, lighter image for the inference API -- no training deps
# (torch-geometric, xgboost training path, dvc) bloating the serving image.
FROM python:3.11-slim AS builder

WORKDIR /build
RUN pip install --no-cache-dir uv
COPY pyproject.toml .
RUN uv pip install --system --no-cache fastapi uvicorn mlflow prometheus-client boto3 pydantic pandas pyarrow

FROM python:3.11-slim AS runtime

RUN useradd --create-home --shell /bin/bash bionexus
WORKDIR /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY src/bio_nexus/serving/ ./src/bio_nexus/serving/
COPY src/bio_nexus/registry/ ./src/bio_nexus/registry/
COPY src/bio_nexus/utils/ ./src/bio_nexus/utils/
COPY src/bio_nexus/__init__.py ./src/bio_nexus/__init__.py
ENV PYTHONPATH=/app/src

USER bionexus
EXPOSE 8000

CMD ["uvicorn", "bio_nexus.serving.api:app", "--host", "0.0.0.0", "--port", "8000"]
