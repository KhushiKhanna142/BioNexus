# Separate, lighter image for the inference API
FROM python:3.11-slim AS builder

WORKDIR /build
RUN pip install --no-cache-dir uv
COPY pyproject.toml .
# Install CPU-only torch first to keep image compact and build fast (<200MB instead of 2.5GB CUDA)
RUN uv pip install --system --no-cache \
    --index-url https://download.pytorch.org/whl/cpu \
    torch
RUN uv pip install --system --no-cache \
    fastapi \
    uvicorn \
    mlflow \
    prometheus-client \
    boto3 \
    pydantic \
    pydantic-settings \
    pandas \
    pyarrow \
    reportlab \
    torch-geometric \
    scikit-learn \
    omegaconf \
    networkx

FROM python:3.11-slim AS runtime

RUN useradd --create-home --shell /bin/bash bionexus
WORKDIR /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY src/ ./src/
COPY data/serving/ ./data/serving/
COPY data/security/ ./data/security/
COPY configs/ ./configs/

ENV PYTHONPATH=/app/src
ENV BIONEXUS_SERVING_DIR=/app/data/serving
ENV BIONEXUS_ALLOW_MOCK=false
ENV PORT=8000

USER bionexus
EXPOSE 8000

CMD ["sh", "-c", "uvicorn bio_nexus.serving.api:app --host 0.0.0.0 --port ${PORT:-8000}"]
