# Separate, lighter image for the inference API -- no training deps
# (torch-geometric, xgboost training path, dvc) bloating the serving image.
FROM python:3.11-slim AS builder

WORKDIR /build
RUN pip install --no-cache-dir uv
COPY pyproject.toml .
RUN uv pip install --system --no-cache fastapi uvicorn mlflow prometheus-client boto3 pydantic

FROM python:3.11-slim AS runtime

RUN useradd --create-home --shell /bin/bash mosaic
WORKDIR /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY src/mosaic/serving/ ./src/mosaic/serving/
COPY src/mosaic/registry/ ./src/mosaic/registry/
COPY src/mosaic/utils/ ./src/mosaic/utils/
COPY src/mosaic/__init__.py ./src/mosaic/__init__.py
ENV PYTHONPATH=/app/src

USER mosaic
EXPOSE 8000

CMD ["uvicorn", "mosaic.serving.api:app", "--host", "0.0.0.0", "--port", "8000"]
